# Optional: only needed if you wire the contact form to an email-sending
# provider (e.g. Resend) instead of the default mailto fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=scholar@example.edu

# Optional: only needed if you enable privacy-respecting analytics
# (e.g. Plausible or Umami). Leave blank to run with no analytics.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
